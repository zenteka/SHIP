# AdGuard Home — copy this to .env and fill in your own values.

# The server's Tailscale tailnet IP (Tailscale DNS will point here). e.g. 100.100.100.100
TAILNET_IP=100.x.y.z

# The server's LAN IP (optional — only if LAN devices query it directly).
# If you don't need LAN DNS, set this equal to TAILNET_IP, or remove the LAN port lines in the compose.
LAN_IP=192.168.x.y

# Where AdGuard stores its config + runtime data — a path OUTSIDE this repo, on the host.
ADGUARD_DATA=/path/to/adguard    # e.g. /srv/adguard or /opt/adguard

# uMap + tileserver — copy this to .env and fill in your own values.

# Django secret — generate a long random one and keep it secret:
#   python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-generate-a-long-random-hex

# Your uMap URL (behind Tailscale Serve HTTPS), WITH trailing slash:
SITE_URL=https://your-host.your-tailnet.ts.net/

# Same host, NO trailing slash — used for the tileserver's public_url (which serves /tiles/):
TS_HOST=https://your-host.your-tailnet.ts.net

# uMap data dir (holds db/, uploads/, statics/, umap.conf) — a path OUTSIDE this repo, on the host:
UMAP_DATA=/path/to/umap            # e.g. /srv/umap

# Tiles data dir (holds your .mbtiles) — OUTSIDE this repo:
TILES_DATA=/path/to/tiles/data     # e.g. /srv/tiles/data

# Vaultwarden — copy this to .env and fill in your own values.

# Your Tailscale Serve HTTPS URL — scheme + host + port.
# e.g. https://your-host.your-tailnet.ts.net:8443
TS_HOST=https://your-host.your-tailnet.ts.net:8443

# Where the vault lives (SQLite db + attachments + keys) — a path OUTSIDE this repo, on the host.
# ⚠️ BACK THIS UP — losing it means losing every stored password.
VAULT_DATA=/path/to/vaultwarden/data    # e.g. /srv/vaultwarden/data

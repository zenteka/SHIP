# Navidrome (music streaming) — copy this to .env and fill in your own values.

# Your music library — read-only to Navidrome. Keep it OUTSIDE this repo, ideally on an HDD
# (streaming is sequential + low-bandwidth, so SSD gives no benefit; libraries are big).
MUSIC_DIR=/path/to/music            # e.g. /srv/music  (on an HDD)

# Navidrome's own data (DB + cache) — small, snappier on SSD.
NAVIDROME_DATA=/path/to/navidrome   # e.g. /srv/navidrome  (on an SSD)

# Run Navidrome as this user so it can READ the library (your uid:gid).
PUID=1000
PGID=1000

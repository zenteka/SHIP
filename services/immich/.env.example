# Immich — copy to .env and fill in your own values.
# Docs: https://docs.immich.app/install/environment-variables

# Where uploaded photos/videos are stored — a path on the HOST, outside this repo:
UPLOAD_LOCATION=/mnt/data/immich

# Where the Postgres database is stored — also a HOST path, NOT a network share and
# NOT inside this repo (a relative ./path would put the live DB in the synced repo):
DB_DATA_LOCATION=/mnt/data/immich/postgres

# Timezone (optional):
# TZ=Europe/Warsaw

# Immich version to run (pin to a release tag, e.g. v2.1.0):
IMMICH_VERSION=v3

# Postgres password — generate a random one (A-Za-z0-9 only), keep it secret:
DB_PASSWORD=change-me-generate-a-random-password

# These do not need to change:
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

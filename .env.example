# Global placeholders shared across services — copy to .env and fill in your own.
# Per-service secrets live in each service's own .env; these are the shared infra
# values referenced throughout the configs and README (e.g. ${TS_HOST}).

# Your Tailscale MagicDNS host (no scheme), e.g. host.tailXXXXXX.ts.net
TS_HOST=host.tailXXXXXX.ts.net

# The server's tailnet IP (100.x.y.z)
TAILNET_IP=100.x.y.z

# The server's LAN IP (optional)
LAN_IP=192.168.x.y
